      var mx=5; T.forEach(function(x){ var k=Number(x.id.replace(/\D/g,'')); if(k>mx) mx=k; });
      t={id:'C'+String(mx+1).padStart(2,'0'),claimed:0,issued:0,code:'',channel:''};
      T.push(t); curId=t.id; created=true;
    }else t=find(curId);
    for(var k in d) if(d.hasOwnProperty(k)) t[k]=d[k];
    t.type=curType;
    if(curType==='push'){
      var count=/328/.test(t.pushTarget)?328:(/近 30 天/.test(t.pushTarget)?126:84),
          per=t.pushPer||1, total=count*per;
      t.issued=(Number(t.issued)||0)+total;
      me.coupons.push({name:t.name,amount:t.amount,threshold:t.threshold,valid:t.valid,source:'后台直接发放 · 无需领取',cid:t.id});
      me.records.unshift(rec('指定人群包',t.name,'后台直发 · '+t.pushTarget,'免领取校验','直发入账 '+fmt(total)+' 张'));
      log('配置「'+esc(t.name)+'」为后台直接发放：'+esc(t.pushTarget)+' · 每人 '+per+' 张 · 共 '+fmt(total)+' 张，券直接进入宠主端我的优惠券');
      toast(el,'已按「后台直接发放」投放 '+fmt(total)+' 张，宠主端「我的优惠券」已入账');
    }else{
      t.code=t.code||genCode(); t.status=t.status==='pause'?'pause':'on';
      me.records.unshift(rec('系统',t.name,'上架 · '+t.entry,'待用户领取','已上架'));
      log('配置「'+esc(t.name)+'」为用户主动领取：入口 '+esc(t.entry)+' · 可领人群 '+esc(audienceName(t.audience))+' · 每人限 '+t.per+' 张 · 库存 '+fmt(t.stock)+' · 券码 '+t.code);
