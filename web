/* 全局 toast：手机内挂在手机上，后台/官网挂在页面顶部 */
function toast(el,msg){
  let host = phoneOf(el), t;
  if(host){
    t = host.querySelector(':scope > .toast');
    if(!t){ t=document.createElement('div'); t.className='toast'; host.appendChild(t); }
  }else{
    t = $('global-toast');
    if(!t){ t=document.createElement('div'); t.id='global-toast'; t.className='global-toast'; document.body.appendChild(t); }
  }
  t.textContent = msg; t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(()=>t.classList.remove('show'), 1900);
}

/* 统一弹窗：选项 + 确定 + 取消，关闭后一定还有后续动作 */
function dialog(opt){
  let mask = $('app-dialog-mask');
  if(!mask){
    mask = document.createElement('div');
    mask.id='app-dialog-mask'; mask.className='app-dialog-mask';
    mask.innerHTML = '<div class="app-dialog"><h3 id="dlg-title"></h3><p id="dlg-desc"></p><div class="d-opts" id="dlg-opts"></div><div class="d-actions"><button class="btn outline" id="dlg-cancel">取消</button><button class="btn" id="dlg-ok">确定</button></div></div>';
    document.body.appendChild(mask);
  }
  const title=$('dlg-title'), desc=$('dlg-desc'), opts=$('dlg-opts'), ok=$('dlg-ok'), cg=$('dlg-cancel');
  title.textContent = opt.title || '提示';
  desc.textContent = opt.desc || ''; desc.style.display = opt.desc ? '' : 'none';
  opts.innerHTML='';
  (opt.options||[]).forEach((o,i)=>{
    const b=document.createElement('button'); b.type='button'; b.className='d-chip'+(i===0?' on':''); b.textContent=o;
    b.onclick=()=>{ opts.querySelectorAll('.d-chip').forEach(x=>x.classList.remove('on')); b.classList.add('on'); };
    opts.appendChild(b);
  });
  opts.style.display = (opt.options && opt.options.length) ? '' : 'none';
  ok.textContent = opt.ok || '确定';
  cg.textContent = opt.cancel || '取消';
  cg.style.display = opt.cancel === null ? 'none' : '';
  const close = ()=> mask.classList.remove('show');
  ok.onclick = ()=>{ const v=opts.querySelector('.d-chip.on'); close(); if(opt.onOk) opt.onOk(v?v.textContent:''); };
  cg.onclick = ()=>{ close(); if(opt.onCancel) opt.onCancel(); };
  mask.onclick = e=>{ if(e.target===mask){ close(); if(opt.onCancel) opt.onCancel(); } };
  mask.classList.add('show');
}

/* 手机内旧弹窗：修正参数顺序为 (phoneId,title,desc,okText,cancelText,onConfirm) */
function openModal(phoneId,title,desc,okText,cancelText,onConfirm){
  const phone = $(phoneId);
  if(!phone){ dialog({title,desc,ok:okText,cancel:cancelText,onOk:onConfirm}); return; }
  try{ focusTo(phone); }catch(e){}
