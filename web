function adminRowsOf(k){
  const b=document.querySelector('[data-rows="'+k+'"]');
  return b?[...b.querySelectorAll('tr[data-row]')]:[];
}
function adminSelCount(k){
  const box=document.querySelector('[data-batch="'+k+'"]'); if(!box) return;
  const n=[...document.querySelectorAll('[data-rowcheck="'+k+'"]')].filter(c=>c.checked).length;
  const num=box.querySelector('[data-n]'); if(num) num.textContent=n;
  box.classList.toggle('off',n===0);
}
function adminApply(k){
  const st=ADMIN_TABLE[k]; if(!st) return;
  const rows=adminRowsOf(k), kw=st.q.trim().toLowerCase();
  const matched=rows.filter(r=>{
    const okQ=!kw||(r.dataset.kw||'').toLowerCase().indexOf(kw)>=0;
    const okS=!st.status||r.dataset.status===st.status;
    return okQ&&okS;
  });
  const pages=Math.max(1,Math.ceil(matched.length/st.size));
  if(st.page>pages) st.page=pages;
  const start=(st.page-1)*st.size;
  rows.forEach(r=>{ const i=matched.indexOf(r); r.style.display=(i>=start&&i<start+st.size)?'':'none'; });
  const empty=document.querySelector('[data-empty="'+k+'"]');
  if(empty) empty.style.display=matched.length?'none':'';
  const cnt=document.querySelector('[data-count="'+k+'"]');
  if(cnt) cnt.textContent='共 '+matched.length+' 条';
  const pg=document.querySelector('[data-pager="'+k+'"]');
  if(pg){
    const info=pg.querySelector('[data-info]');
    if(info) info.textContent='共 '+matched.length+' 条 · 第 '+st.page+'/'+pages+' 页';
    pg.querySelectorAll('[data-dir]').forEach(b=>{ b.disabled=(b.dataset.dir==='-1'?st.page<=1:st.page>=pages); });
    pg.style.display=(pages<=1)?'none':'flex';
  }
  adminSelCount(k);
}
function adminInitTables(){
  document.querySelectorAll('[data-rows]').forEach(b=>{
    const k=b.dataset.rows;
    ADMIN_TABLE[k]={page:1,size:(k==='member'||k==='sitter'||k==='user')?3:999,q:'',status:null};
    [...b.querySelectorAll('tr[data-row]')].forEach(r=>{
      r.dataset.kw=[...r.querySelectorAll('td')].map(td=>td.textContent.replace(/\s+/g,' ').trim()).join(' ');
    });
  });
  Object.keys(ADMIN_TABLE).forEach(adminApply);
}
window.addEventListener('load', ()=>setTimeout(adminInitTables,40));
