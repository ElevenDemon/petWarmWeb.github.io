    var em=q('#wp-pf-current-emoji'); if(em) em.textContent=p.emoji||'🐾';
    var badge=q('#wp-pf-current-badge');
    if(badge){ badge.className='pill '+statusOf(p.status)[2]; badge.textContent=statusOf(p.status)[1]; }
    var hint=q('#wp-pf-switch-hint');
    if(hint) hint.innerHTML='共 <b>'+n+'</b> 位喂养师 · 正在编辑第 <b>'+(i+1)+'</b> 位 · 输入姓名 / 工号 / 区域可快速定位，也可用「上一位 / 下一位」顺序检查';
    var pv=q('#wp-pf-prev'), nx=q('#wp-pf-next');
    if(pv) pv.disabled=(i<=0);
    if(nx) nx.disabled=(i>=n-1);
    var box=q('#wp-addr-tabs');
    if(box){
      var secs=qa('#wp-addr-card .wp-pf-sec');
      var names=['① 基本信息','② 资质与结算','③ 常驻地址','④ 每日档期'];
      var on=box.querySelector('.chip.on[data-jump]'), keep=on?Number(on.getAttribute('data-jump')):0;
      if(isNaN(keep)||keep<0) keep=0;
      box.innerHTML=secs.slice(0,4).map(function(s,j){
        return '<span class="chip'+(j===keep?' on':'')+'" data-jump="'+j+'" onclick="act(this,\'adminProfileJump\')">'+names[j]+'</span>';
      }).join('');
    }
  }
  function renderGradeOptions(){
    var e=q('#wp-pf-grade'), p=cur(); if(!e||!p) return;
    var gs=grades().filter(function(g){return g.on!==false;});
    var has=gs.some(function(g){return g.code===p.grade;});
    e.innerHTML=(has?'':'<option value="'+esc(p.grade)+'">'+esc(p.grade)+'（自定义）</option>')
      +gs.map(function(g){ return '<option value="'+esc(g.code)+'">'+esc(g.code+' '+g.name)+' · 抽成'+esc(g.rate)+'% · 权重+'+esc(g.weight)+'%</option>'; }).join('');
    e.value=p.grade;
  }
  function renderForm(){
    var p=cur(); if(!p) return;
    var s=S();
    renderHead(); renderGradeOptions();
    set('wp-pf-name',p.name); set('wp-pf-phone',p.phone); set('wp-pf-join',p.join);
    set('wp-pf-contact',p.contact); set('wp-pf-note',p.note); set('wp-pf-emoji',p.emoji);
    set('wp-pf-grade',p.grade); set('wp-pf-cats',(p.cats||[]).join(' · '));
    set('wp-pf-status',p.status); set('wp-pf-rate',p.rate); set('wp-pf-settle',p.settle);
    txt('#wp-pf-id',p.id); txt('#wp-pf-score',p.score+' 分');
    txt('#wp-pf-area-view',p.area+' · 半径 '+p.radius+'km');
    /* 喂养师端同源表单 */
    set('wp-pf-m-name',p.name); set('wp-pf-m-phone',p.phone);
    set('wp-pf-m-street',p.street); set('wp-pf-m-area',p.area);
    set('wp-pf-m-radius',p.radius); set('wp-pf-m-transit',p.transit);
    set('wp-pf-m-cats',(p.cats||[]).join(' · ')); set('wp-pf-m-note',p.note);
    txt('#wp-pf-m-id',p.id); txt('#wp-pf-m-grade',gradeLabel(p.grade));
    txt('#wp-pf-m-rate',p.rate+'%'); txt('#wp-pf-m-status',statusOf(p.status)[1]);
    var d=(p.week||[])[(new Date().getDay()||7)-1]||(p.week||[])[0]||{};
    txt('#wp-pf-m-today',d.rest?'今日休息 · AI 不派单':('今日 '+(d.from||'09:00')+'–'+(d.to||'18:00')+' · 可接 '+(d.cap==null?0:d.cap)+' 单'+(d.addr?' · 当日地址 '+d.addr:'')));
    renderDiff();
  }

  /* ---------- 待保存改动 + 下游影响（可解释） ---------- */
  function diffList(){
    var p=cur(), out=[]; if(!p) return out;
    var fields=[['wp-pf-name','name','姓名'],['wp-pf-phone','phone','手机号'],['wp-pf-join','join','加入时间'],
      ['wp-pf-contact','contact','紧急联系人'],['wp-pf-note','note','备注'],['wp-pf-emoji','emoji','头像'],
      ['wp-pf-grade','grade','认证等级'],['wp-pf-status','status','账号状态'],
      ['wp-pf-rate','rate','平台抽成'],['wp-pf-settle','settle','结算方式']];
    fields.forEach(function(f){
      var v=val(f[0]), old=String(p[f[1]]==null?'':p[f[1]]);
      if(v!==old) out.push({k:f[1],label:f[2],from:old||'空',to:v||'空'});
    });
    var cv=val('wp-pf-cats'), oc=(p.cats||[]).join(' · ');
    if(cv!==oc) out.push({k:'cats',label:'擅长类目',from:oc||'空',to:cv||'空'});
    [['wp-addr-street','street','常驻地址'],['wp-addr-area','area','所在区'],
     ['wp-addr-lat','lat','纬度'],['wp-addr-lng','lng','经度'],
     ['wp-addr-radius','radius','服务半径'],['wp-addr-transit','transit','交通方式']].forEach(function(f){
      var e=q('#'+f[0]); if(!e) return;
      var v=String(e.value).trim(), old=String(p[f[1]]==null?'':p[f[1]]);
      if(v!==old) out.push({k:f[1],label:f[2],from:old||'空',to:v||'空'});
    });
    qa('#wp-addr-week .wp-addr-day').forEach(function(r,i){
      var d=(p.week||[])[i]||{}, g=function(f){ var e=r.querySelector('[data-f="'+f+'"]'); return e?String(e.value).trim():''; };
      ['addr','area','from','to','cap'].forEach(function(f){
        var v=g(f), old=String(d[f]==null?'':d[f]);
        if(v!==old) out.push({k:'week',label:'周'+(i+1)+' '+f,from:old||'空',to:v||'空'});
      });
      var rest=r.getAttribute('data-rest')==='1';
      if(rest!==!!d.rest) out.push({k:'week',label:'周'+(i+1)+' 休息日',from:d.rest?'是':'否',to:rest?'是':'否'});
    });
    return out;
  }
  function renderDiff(){
    var box=q('#wp-pf-diff'); if(!box) return;
    var d=diffList(), p=cur(), warns=[];
    if(!d.length){
      box.innerHTML='<div class="wp-pf-diff-h">档案变更预览 <span class="pill ok">无待保存改动</span></div>'
        +'<div class="small faint">在上方任一字段改动后，这里会列出具体改动，并说明会同步到哪些下游。地址与每日档期属于本档案的 ③④ 段，与基本信息一次保存。</div>';
      return;
    }
    d.forEach(function(x){
      if(x.k==='status'&&x.to==='off') warns.push('账号停用后 AI 派单会直接淘汰该喂养师');
      if(x.k==='grade') warns.push('等级变化会改变派单权重与高风险类目（遛狗 / 喂药 / 应急送医）准入');
      if(x.k==='rate') warns.push('抽成变化自下个结算周期生效，进行中订单按下单时抽成结算');
      if(x.k==='cats') warns.push('类目变化立即影响 AI 派单的类目匹配');
      if(x.k==='radius'||x.k==='area'||x.k==='street'||x.k==='lat'||x.k==='lng') warns.push('地址 / 半径变化立即影响 AI 距离硬过滤');
      if(x.k==='week') warns.push('每日档期变化立即影响当日时段与容量判定');
    });
    var uniq=[]; warns.forEach(function(w){ if(uniq.indexOf(w)<0) uniq.push(w); });
    box.innerHTML='<div class="wp-pf-diff-h">档案变更预览 <span class="pill warn">'+d.length+' 处待保存</span></div>'
      +'<div class="wp-pf-diff-list">'+d.slice(0,8).map(function(x){
          return '<div class="wp-pf-diff-row"><b>'+esc(x.label)+'</b>：'+esc(x.from)+' <span class="wp-pf-arrow">→</span> <b>'+esc(x.to)+'</b></div>';
        }).join('')+(d.length>8?'<div class="small faint">…另有 '+(d.length-8)+' 处改动</div>':'')+'</div>'
      +'<div class="wp-pf-diff-sync"><b>保存后同步</b>：喂养师列表行 · 档案详情卡 · 喂养师端「我的档案」· ✦ AI 派单判定 · 财务结算抽成 · 操作日志</div>'
      +uniq.map(function(w){ return '<div class="wp-pf-diff-warn">⚠ '+esc(w)+'</div>'; }).join('');
  }

  /* ---------- 校验与收集 ---------- */
  function collectProfile(){
    var bad=[], focus=null;
    function need(id,cond,msg){ if(!cond && !bad.length){ bad.push(msg); focus=id; } }
    var name=val('wp-pf-name'), phone=val('wp-pf-phone'), cats=val('wp-pf-cats'),
        rate=Number(val('wp-pf-rate')), grade=val('wp-pf-grade'), status=val('wp-pf-status'),
        note=val('wp-pf-note');
    need('wp-pf-name',!!name&&name.length<=12,'姓名不能为空且不超过 12 字');
    need('wp-pf-phone',/^1[3-9]\d{9}$/.test(phone),'手机号需为 11 位有效号码');
    need('wp-pf-grade',!!grade&&grades().some(function(g){return g.code===grade&&g.on!==false;}),'认证等级需选择已启用的等级');
    need('wp-pf-status',STATUS.some(function(x){return x[0]===status;}),'账号状态无效');
    need('wp-pf-rate',isFinite(rate)&&rate>=0&&rate<=50,'平台抽成需在 0 – 50% 之间');
    var arr=cats.split(/[·,，、\s]+/).map(function(x){return x.trim();}).filter(Boolean);
    need('wp-pf-cats',arr.length>0,'至少填写一个擅长类目');
    need('wp-pf-note',note.length<=60,'备注不超过 60 字');
    if(bad.length){
      toast(null,'未保存：'+bad[0]);
      var e=q('#'+focus); if(e&&e.focus) e.focus();
      return null;
    }
    return {name:name,phone:phone,join:val('wp-pf-join')||'2025-08',contact:val('wp-pf-contact'),
            note:note,emoji:val('wp-pf-emoji')||'🐾',grade:grade,status:status,
            rate:Math.round(rate*100)/100,settle:val('wp-pf-settle')||'周结',cats:arr};
  }

  /* ---------- 下游联动 ---------- */
  function syncRow(p){
    var tr=qa('#admin-sitter-body tr').filter(function(r){
      var t=r.querySelector('td'); return t&&t.textContent.trim()===p.id;
    })[0];
    if(!tr) return;
    var td=tr.querySelectorAll('td'); if(td.length<9) return;
    td[1].innerHTML='<div class="row"><div class="avatar sm">'+esc(p.emoji||'🐾')+'</div>'+esc(p.name)+'</div>';
    td[2].innerHTML='<span class="pill '+esc(gradeColor(p.grade))+'">'+esc(gradeLabel(p.grade))+'</span>';
    td[3].className='small'; td[3].textContent=(p.cats||[]).join(' · ');
    td[4].textContent=p.area;
    td[5].textContent=p.score;
    td[7].className='small'; td[7].textContent=p.rate+'%';
    td[8].innerHTML='<span class="pill '+statusOf(p.status)[2]+'">'+statusOf(p.status)[1]+'</span>';
    tr.setAttribute('data-status',p.status);
  }
  function syncDetail(p){
    txt('#admin-sitter-name',p.name);
    txt('#admin-sitter-meta',p.id+' · '+p.area+' · 加入 '+p.join);
    txt('#admin-sitter-score',p.score+' 分');
    txt('#admin-sitter-rate',p.rate+'%');
    txt('#admin-sitter-level',gradeLabel(p.grade));
    var s=S(); if(s) s.syncProfileBox();
  }
  function syncMobile(p){
    if(!q('#wp-pf-m-name')) return;
    set('wp-pf-m-name',p.name); set('wp-pf-m-phone',p.phone);
    set('wp-pf-m-street',p.street); set('wp-pf-m-area',p.area);
    set('wp-pf-m-radius',p.radius); set('wp-pf-m-transit',p.transit);
    set('wp-pf-m-cats',(p.cats||[]).join(' · ')); set('wp-pf-m-note',p.note);
    txt('#wp-pf-m-id',p.id); txt('#wp-pf-m-grade',gradeLabel(p.grade));
    txt('#wp-pf-m-rate',p.rate+'%'); txt('#wp-pf-m-status',statusOf(p.status)[1]);
  }

  /* ---------- 动作 ---------- */
  function saveProfile(el){
    var s=S(); if(!s) return false;
    var p=cur(); if(!p) return false;
    var patch=collectProfile(); if(!patch) return false;
    var addr=s.collectAddr(); if(!addr) return false;
    s.apply(p.id,patch,addr);
    syncRow(p); syncDetail(p); syncMobile(p); renderForm();
    log('保存喂养师档案：'+p.name+'（'+p.id+'）· 基本信息 / 资质结算 / 服务地址 / 7 天档期一并更新');
    toast(el,'已保存 '+p.name+' 的完整档案，列表、详情、喂养师端与 AI 派单判定已同步');
    return true;
  }
  function revert(el){
    dialog({title:'放弃未保存的档案修改',desc:'将把基本信息、资质结算、常驻地址与 7 天档期全部还原为上次保存的值，已保存的档案不受影响。',
      options:['确认放弃','继续编辑'],ok:'确认',cancel:'取消',
      onOk:function(v){ if(String(v).indexOf('确认')<0){ toast(el,'已继续编辑'); return; }
        var s=S(); if(s) s.renderAll(); renderForm(); toast(el,'已还原为上次保存的档案'); },
      onCancel:function(){ toast(el,'已继续编辑'); }});
    return true;
  }
  function openFromDetail(el){
    var s=S(); if(!s) return false;
    return openEditor(s.cur(),el,false);
  }
  function pickCat(el){
    var c=el&&el.getAttribute?el.getAttribute('data-cat'):''; if(!c) return false;
    var e=q('#wp-pf-cats'); if(!e) return false;
    var arr=e.value.split(/[·,，、\s]+/).map(function(x){return x.trim();}).filter(Boolean);
    var i=arr.indexOf(c);
    if(i>=0){ arr.splice(i,1); el.classList.remove('on'); } else { arr.push(c); el.classList.add('on'); }
    e.value=arr.join(' · '); renderDiff();
    toast(el,(i>=0?'已移除类目 ':'已添加类目 ')+c+'（需点保存档案生效）');
    return true;
  }
  function saveMobile(el){
    var s=S(); if(!s) return false;
    var p=cur(); if(!p) return false;
    var name=val('wp-pf-m-name'), phone=val('wp-pf-m-phone'), street=val('wp-pf-m-street'),
        cats=val('wp-pf-m-cats'), radius=Number(val('wp-pf-m-radius')), note=val('wp-pf-m-note');
    if(!name||name.length>12){ toast(el,'请先填写不超过 12 字的姓名'); return false; }
    if(!/^1[3-9]\d{9}$/.test(phone)){ toast(el,'手机号需为 11 位有效号码'); return false; }
    if(!street){ toast(el,'常驻地址不能为空'); return false; }
    if(!isFinite(radius)||radius<0.5||radius>50){ toast(el,'服务半径需为 0.5 – 50 km'); return false; }
    var arr=cats.split(/[·,，、\s]+/).map(function(x){return x.trim();}).filter(Boolean);
    if(!arr.length){ toast(el,'至少填写一个擅长类目'); return false; }
    var patch={name:name,phone:phone,street:street,area:val('wp-pf-m-area')||p.area,
               radius:radius,transit:val('wp-pf-m-transit')||p.transit,cats:arr,note:note};
    s.apply(p.id,patch,null);
    syncRow(p); syncDetail(p); renderForm();
    log('喂养师端更新我的档案：'+p.name+'（'+p.id+'）· 基本信息 / 常驻地址');
    toast(el,'已保存我的档案，运营后台与 AI 派单判定已同步（等级 / 抽成由后台设定）');
    return true;
  }
  function mobileLink(el){
    var s=S(); if(!s) return false;
    var box=q('#wp-pf-m-link');
    var link='暖爪-原型图-04-运营后台.html#/admin/sitter?focus=profile&sid='+encodeURIComponent(s.cur());
    if(box) box.value=link;
    toast(el,'已生成后台完整档案编辑入口（复制后在运营后台画布打开）');
    return true;
  }

  /* ---------- act 链式包装（最外层） ---------- */
  var _act=window.act;
  window.act=function(el,key,extra){
    switch(key){
      case 'adminProfileSave': return saveProfile(el);
      case 'adminProfileRevert': return revert(el);
      case 'adminProfileOpen': return openFromDetail(el);
      case 'adminProfileBack': return closeEditor(el);
      case 'adminProfilePick': return pickById(el);
      case 'adminProfileFind': return findList(el);
      case 'adminProfilePrev': return step(-1,el);
      case 'adminProfileNext': return step(1,el);
      case 'adminProfileJump': return jumpSection(el);
      case 'adminProfileCat': return pickCat(el);
      case 'stProfileSave': return saveMobile(el);
      case 'stProfileLink': return mobileLink(el);
      case 'adminAddrPick': { var r=_act(el,key,extra); renderForm(); return r; }
      case 'adminAddrSave': { var r2=_act(el,key,extra); renderForm(); return r2; }
      case 'adminAddrReset': {
        var r3=_act(el,key,extra);
        setTimeout(function(){ hydrate(); renderForm(); },60);
        setTimeout(function(){ hydrate(); renderForm(); },420);
        return r3;
      }
      case 'adminSitterDetail': {
        var tr=el&&el.closest?el.closest('tr'):null;
        var id=tr&&tr.querySelector('td')?tr.querySelector('td').textContent.trim():'';
        var r4=_act(el,key,extra);
        var s=S();
        if(id&&s&&s.get(id)){ s.pick(id); openEditor(id,el,true); }
        return r4;
      }
    }
    return _act(el,key,extra);
  };

  /* ---------- 对外接口（测试 / 其他模块） ---------- */
  window.wpProfileMe=function(){ var p=cur(); return p?JSON.parse(JSON.stringify(p)):null; };
  window.wpProfileDiff=function(){ return diffList(); };
  window.wpProfileRender=renderForm;
  window.wpProfileSave=saveProfile;
  window.wpProfileOpen=openFromDetail;
  window.wpProfileClose=closeEditor;
  window.wpProfileEditing=isEditing;
  window.wpProfileStep=step;

  function fromUrl(){
    var qq=(location.hash.split('?')[1]||'')+(location.search?location.search.replace(/^\?/,''):'');
    var m=/(?:^|&)(?:sid|edit)=([\w-]+)/.exec(qq);
    var want=m?m[1]:null, focusProfile=/focus=profile/.test(qq);
    if(want||focusProfile){
      var s=S();
      if(want&&s&&s.get(want)) s.pick(want);
      openEditor(want||(s?s.cur():null), null, true);
    }
  }
  function cleanSubLinks(){
    qa('.wp-dock .wp-sublink').forEach(function(b){ if(b.parentNode) b.parentNode.removeChild(b); });
  }
  function init(){
    hydrate();
    var card=q('#wp-addr-card');
    if(card){ card.style.display='none'; card.removeAttribute('data-wp-open'); }
    renderForm(); fromUrl(); cleanSubLinks();
    if(card){
      ['input','change'].forEach(function(ev){
        card.addEventListener(ev,function(){ renderDiff(); },true);
      });
    }
    var mob=q('#st-profileedit');
    if(mob){ ['input','change'].forEach(function(ev){ mob.addEventListener(ev,function(){},true); }); }
  }
  window.addEventListener('load',function(){
    init();
    setTimeout(function(){ hydrate(); renderForm(); cleanSubLinks(); },140);
    setTimeout(cleanSubLinks,420);
    setTimeout(cleanSubLinks,900);
  });
  if(document.readyState==='complete') setTimeout(init,0);
})();
/* ===== /WP-PROFILE-JS ===== */
</script>
