/* ===== 全局兜底：无 onclick 的按钮 / 标签 / 返回键 / 卡片全部接管 ===== */
document.addEventListener('click', function(e){
  if(e.target.closest('.topbar')||e.target.closest('.app-dialog-mask')||e.target.closest('.modal-mask')) return;
  if(e.target.closest('[onclick]')) return;   // 实际点击目标已有 handler，交给它，避免重复触发
  const el=e.target.closest('button,.chip,.tb,.s,.check,.upload,.back,.switch,[style*="cursor:pointer"]');
  if(!el) return;
  if(el.classList.contains('tb')) return navTab(el);
  if(el.classList.contains('s')) return pickSeg(el);
  if(el.classList.contains('chip')) return pickChip(el);
  if(el.classList.contains('check')) return tglCheck(el);
  if(el.classList.contains('upload')) return act(el,'upload');
  if(el.classList.contains('back')) return goBack(el);
  if(el.classList.contains('switch')) return toggleSwitch(el);
  return act(el,'generic');
}, false);

