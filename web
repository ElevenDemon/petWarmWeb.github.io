<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>暖爪 · 运营后台 · 独立画布（全交互）</title>
<style>
  :root{
    --brand:#E8622D;
    --brand-deep:#C74E1E;
    --brand-soft:#FBE9DF;
    --ink:#2B2A28;
    --ink-2:#6E6A64;
    --ink-3:#A39D94;
    --paper:#F6F3ED;
    --card:#FFFFFF;
    --line:#EAE4DA;
    --green:#3D7A5C;
    --green-soft:#E5F1E9;
    --red:#C94A3F;
    --red-soft:#FBE3E0;
    --amber:#C98A2D;
    --amber-soft:#FDF1DC;
    --purple:#6A4FB0;
    --purple-soft:#F1ECFB;
    --radius:18px;
    --radius-s:12px;
    --radius-xs:9px;
    --shadow-sm:0 1px 3px rgba(43,42,40,.06);
    --shadow-md:0 4px 16px rgba(43,42,40,.08);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{height:100%;}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
    background:var(--paper);color:var(--ink);font-size:14px;
    -webkit-font-smoothing:antialiased;
  }
  .topbar{
    position:fixed;top:0;left:0;right:0;z-index:50;height:60px;
    background:rgba(255,255,255,.94);backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);padding:0 24px;
    display:flex;align-items:center;justify-content:space-between;gap:16px;
  }
  .brand{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:600;letter-spacing:.3px;white-space:nowrap;}
  .brand .paw{width:34px;height:34px;border-radius:11px;background:var(--brand);display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;box-shadow:var(--shadow-sm);}
  .tabs{display:flex;gap:6px;flex-wrap:wrap;align-items:center;}
  .tab{border:1px solid var(--line);background:transparent;color:var(--ink-2);padding:7px 15px;border-radius:999px;cursor:pointer;font-size:13px;transition:.15s;font-family:inherit;white-space:nowrap;}
  .tab:hover{border-color:var(--brand);color:var(--brand);}
  .tab.active{background:var(--brand);border-color:var(--brand);color:#fff;}
  .zoomgroup{display:flex;align-items:center;gap:6px;}
  .zoomgroup button{width:34px;height:34px;border-radius:9px;border:1px solid var(--line);background:#fff;color:var(--ink-2);cursor:pointer;font-size:17px;line-height:1;display:flex;align-items:center;justify-content:center;transition:.15s;font-family:inherit;}
  .zoomgroup button:hover{border-color:var(--brand);color:var(--brand);}
  .zoomgroup .zlabel{font-size:12px;color:var(--ink-2);min-width:46px;text-align:center;font-variant-numeric:tabular-nums;}

  /* 画布容器：可缩放 + 拖动平移 */
  .canvas-viewport{position:fixed;top:60px;left:0;right:0;bottom:0;overflow:hidden;background:
    radial-gradient(circle, rgba(43,42,40,.05) 1px, transparent 1px);background-size:22px 22px;cursor:grab;}
  .canvas-viewport.grabbing{cursor:grabbing;}
  .canvas{position:absolute;top:0;left:0;transform-origin:0 0;padding:40px 32px 120px;width:max-content;min-width:100%;will-change:transform;}

  .wrap{max-width:none;margin:0 auto;padding:0 0 20px;}
  .zone{background:#fff;border:1px solid var(--line);border-radius:20px;padding:28px 28px 20px;margin:0 auto 40px;width:1280px;max-width:calc(100vw - 64px);box-shadow:var(--shadow-sm);box-sizing:border-box;}
  .zone-head{display:flex;align-items:center;gap:12px;margin-bottom:6px;}
  .zone-head .zn{font-size:19px;font-weight:700;}
  .zone-head .cnt{font-size:12px;color:var(--ink-2);background:#F1EDE6;padding:3px 10px;border-radius:999px;}
  .zone-sub{color:var(--ink-2);font-size:13px;margin-bottom:24px;line-height:1.6;}
  .zone .grid{gap:28px;}
  .page-title{font-size:25px;font-weight:600;margin-bottom:6px;}
  .page-sub{color:var(--ink-2);font-size:14px;margin-bottom:26px;line-height:1.6;}
  .section{margin-bottom:34px;}
  .section-h{display:flex;align-items:center;gap:10px;margin-bottom:16px;font-size:15px;font-weight:600;}
  .section-h::before{content:"";width:4px;height:16px;background:var(--brand);border-radius:2px;}
  .section-h .tag{font-size:11px;font-weight:400;color:var(--ink-2);background:#ECE7DE;padding:2px 9px;border-radius:999px;}
  .grid{display:grid;gap:20px;}
  .g-2{grid-template-columns:repeat(2,1fr);}
  .g-3{grid-template-columns:repeat(3,1fr);}
  .g-4{grid-template-columns:repeat(4,1fr);}
  @media(max-width:900px){.g-2,.g-3,.g-4{grid-template-columns:1fr;}}

  .phone{
    width:375px;margin:0 auto;background:var(--card);border:1px solid var(--line);
    border-radius:30px;overflow:hidden;box-shadow:var(--shadow-md);position:relative;
  }
  .phone .status{display:flex;justify-content:space-between;align-items:center;padding:13px 20px 7px;font-size:12px;color:var(--ink-2);}
  .phone .nav{display:flex;align-items:center;justify-content:space-between;padding:6px 20px 14px;font-size:17px;font-weight:600;}
  .phone .nav .back{color:var(--ink-2);font-weight:400;font-size:15px;cursor:pointer;}
  .phone .nav .back:hover{color:var(--brand);}
  .phone .body{padding:0 20px 24px;min-height:520px;}
  .tabbar{display:flex;border-top:1px solid var(--line);background:var(--card);}
  .tabbar .tb{flex:1;text-align:center;padding:9px 0 14px;font-size:11px;color:var(--ink-2);cursor:pointer;border:none;background:none;font-family:inherit;}
  .tabbar .tb .ic{font-size:18px;display:block;margin-bottom:2px;}
  .tabbar .tb.on{color:var(--brand);}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;background:var(--brand);color:#fff;border:none;border-radius:999px;padding:13px 20px;font-size:15px;font-weight:500;cursor:pointer;width:100%;transition:.15s;font-family:inherit;}
  .btn:hover{background:var(--brand-deep);}
  .btn.ghost{background:var(--brand-soft);color:var(--brand-deep);}
  .btn.ghost:hover{background:#F6DCC8;}
  .btn.outline{background:#fff;color:var(--ink);border:1px solid var(--line);}
  .btn.outline:hover{border-color:var(--brand);color:var(--brand);}
  .btn.sm{padding:9px 14px;font-size:13px;width:auto;}
  .btn.danger{background:var(--red);}
  .btn.danger:hover{background:#B23E35;}
  .btn:disabled{opacity:.45;cursor:not-allowed;}

  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius-s);padding:16px;}
  .chip{display:inline-flex;align-items:center;gap:4px;border:1px solid var(--line);border-radius:999px;padding:7px 13px;font-size:12px;color:var(--ink-2);cursor:pointer;background:#fff;font-family:inherit;}
  .chip.on{background:var(--brand-soft);border-color:var(--brand);color:var(--brand-deep);font-weight:500;}
  .row{display:flex;align-items:center;gap:10px;}
  .between{display:flex;align-items:center;justify-content:space-between;}
  .muted{color:var(--ink-2);}
  .faint{color:var(--ink-3);}
  .small{font-size:12px;}
  .tiny{font-size:11px;}
  .price{color:var(--brand-deep);font-weight:600;}
  .dot{width:8px;height:8px;border-radius:50%;display:inline-block;}
  .dot.g{background:var(--green);}.dot.r{background:var(--red);}.dot.a{background:var(--amber);}
  .pill{font-size:11px;padding:3px 9px;border-radius:999px;white-space:nowrap;}
  .pill.ok{background:var(--green-soft);color:var(--green);}
  .pill.warn{background:var(--amber-soft);color:var(--amber);}
  .pill.danger{background:var(--red-soft);color:var(--red);}
  .pill.ai{background:var(--purple-soft);color:var(--purple);}
  .divider{height:1px;background:var(--line);margin:14px 0;}
  .avatar{width:40px;height:40px;border-radius:50%;background:#F0ECE5;display:flex;align-items:center;justify-content:center;color:var(--ink-2);font-size:16px;flex-shrink:0;}
  .avatar.lg{width:52px;height:52px;font-size:21px;}
  .avatar.sm{width:30px;height:30px;font-size:14px;}

  .hero{border-radius:26px;overflow:hidden;background:linear-gradient(135deg,#2B2A28 0%,#3A312B 100%);color:#fff;padding:60px 52px;position:relative;}
  .hero .h1{font-size:38px;font-weight:700;line-height:1.28;margin-bottom:16px;max-width:540px;}
  .hero .h1 em{font-style:normal;color:#F2A176;}
  .hero p{color:#C9C2B9;font-size:16px;max-width:470px;line-height:1.7;margin-bottom:28px;}
  .hero .cta{display:flex;gap:12px;align-items:center;}
  .hero .btn{width:auto;}
  .hero .btn.ghost{background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.25);}
  .hero .qr{position:absolute;right:52px;top:50%;transform:translateY(-50%);background:#fff;border-radius:18px;padding:16px;text-align:center;color:var(--ink);box-shadow:var(--shadow-md);}
  .hero .qr .q{width:118px;height:118px;background:#F0ECE5;border-radius:10px;margin-bottom:8px;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--ink-2);}
  .hero .qr .t{font-size:12px;}
  @media(max-width:760px){.hero .qr{display:none;}.hero{padding:36px 24px;}}

  .kv{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .kv .k{background:#fff;border:1px solid var(--line);border-radius:var(--radius-s);padding:22px;text-align:center;box-shadow:var(--shadow-sm);}
  .kv .k .num{font-size:28px;font-weight:700;color:var(--brand-deep);}
  .kv .k .lb{font-size:12px;color:var(--ink-2);margin-top:4px;}

  table{width:100%;border-collapse:collapse;font-size:13px;}
  th,td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--line);}
  th{color:var(--ink-2);font-weight:500;font-size:12px;background:#FBF9F5;}
  tr:last-child td{border-bottom:none;}
  .flow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .flow .fstep{background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 16px;font-size:13px;display:flex;align-items:center;gap:8px;box-shadow:var(--shadow-sm);}
  .flow .fstep .n{width:20px;height:20px;border-radius:50%;background:var(--brand);color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center;}
  .flow .arr{color:var(--ink-3);}
  .flow .fstep.ai{border-color:#D8CBF3;background:#FAF7FE;}
  .flow .fstep.ai .n{background:var(--purple);}

  .report{border-left:4px solid var(--green);background:#F6FBF8;border-radius:var(--radius-xs);padding:14px 16px;}
  .report.warn{border-color:var(--amber);background:#FDF8EE;}
  .check{display:flex;align-items:center;gap:8px;padding:8px 0;font-size:13px;}
  .check .box{width:18px;height:18px;border-radius:5px;border:1.5px solid var(--brand);display:flex;align-items:center;justify-content:center;color:var(--brand);font-size:12px;flex-shrink:0;}
  .check .box.done{background:var(--brand);color:#fff;}
  .ai-banner{background:var(--purple-soft);border:1px solid #E4DAF5;border-radius:12px;padding:12px 14px;display:flex;gap:10px;align-items:flex-start;font-size:12px;color:#4A3A78;line-height:1.6;}
  .ai-banner .spark{color:var(--purple);font-size:15px;flex-shrink:0;margin-top:1px;}

  .toast{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);background:rgba(43,42,40,.92);color:#fff;border-radius:12px;padding:14px 22px;font-size:13px;z-index:20;opacity:0;pointer-events:none;transition:.3s;text-align:center;white-space:nowrap;}
  .toast.show{opacity:1;}
  .stepbar{display:flex;align-items:center;gap:6px;margin-bottom:16px;}
  .stepbar .st{flex:1;height:3px;border-radius:2px;background:var(--line);}
  .stepbar .st.on{background:var(--brand);}
  .agree{max-height:140px;overflow-y:auto;border:1px solid var(--line);border-radius:var(--radius-xs);padding:12px;font-size:12px;color:var(--ink-2);line-height:1.7;background:#FBF9F5;}
  .msgbubble{max-width:78%;padding:10px 13px;border-radius:14px;font-size:13px;line-height:1.6;margin-bottom:8px;}
  .msgbubble.in{background:#F1F0EE;color:var(--ink);border-top-left-radius:4px;}
  .msgbubble.out{background:var(--brand);color:#fff;margin-left:auto;border-top-right-radius:4px;}

  .phone .screen{animation:fadein .25s ease;}
  @keyframes fadein{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}
  .modal-mask{position:absolute;inset:0;background:rgba(30,28,25,.45);z-index:30;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:.2s;}
  .modal-mask.show{opacity:1;pointer-events:auto;}
  .modal-mask.page{position:fixed;}
  .modal{background:#fff;border-radius:16px;width:82%;padding:20px;text-align:center;}
  .modal .m-title{font-weight:600;font-size:15px;margin-bottom:8px;}
  .modal .m-desc{font-size:12px;color:var(--ink-2);margin-bottom:16px;line-height:1.6;}
  .modal .m-actions{display:flex;gap:8px;}
  .modal .m-actions .btn{flex:1;}
  .switch{position:relative;width:44px;height:24px;border-radius:999px;background:#DDD8CF;cursor:pointer;transition:.2s;flex-shrink:0;}
  .switch.on{background:var(--green);}
  .switch::after{content:"";position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;transition:.2s;box-shadow:var(--shadow-sm);}
  .switch.on::after{left:22px;}
  .seg{display:flex;background:#F1EDE6;border-radius:999px;padding:3px;margin-bottom:16px;}
  .seg .s{flex:1;text-align:center;padding:8px 0;font-size:13px;color:var(--ink-2);cursor:pointer;border-radius:999px;border:none;background:none;font-family:inherit;}
  .seg .s.on{background:#fff;color:var(--ink);font-weight:500;box-shadow:var(--shadow-sm);}
  .form-item{margin-bottom:14px;}
  .form-item .lb{font-size:12px;color:var(--ink-2);margin-bottom:6px;}
  .input{width:100%;border:1px solid var(--line);border-radius:10px;padding:11px 13px;font-size:13px;background:#FBF9F5;font-family:inherit;color:var(--ink);}
  .input:focus{outline:none;border-color:var(--brand);background:#fff;}
  .upload{width:100%;border:1.5px dashed var(--line);border-radius:12px;padding:20px;text-align:center;color:var(--ink-3);font-size:12px;cursor:pointer;background:#FBF9F5;}
  .upload:hover{border-color:var(--brand);color:var(--brand);}
  .timeline{position:relative;padding-left:20px;}
  .timeline::before{content:"";position:absolute;left:5px;top:4px;bottom:4px;width:1px;background:var(--line);}
  .timeline .tl{position:relative;padding-bottom:16px;}
  .timeline .tl::before{content:"";position:absolute;left:-20px;top:4px;width:11px;height:11px;border-radius:50%;background:#fff;border:2px solid var(--brand);}
  .timeline .tl.done::before{background:var(--brand);}
  .timeline .tl .tt{font-size:13px;font-weight:500;margin-bottom:2px;}
  .timeline .tl .ts{font-size:11px;color:var(--ink-3);}

  /* ===== 四端独立画布 ===== */
  .board{display:none;}
  .board.active{display:block;}
  a.tab{text-decoration:none;display:inline-flex;align-items:center;}
  .canvas-badge{font-size:11px;color:var(--ink-2);background:#F1EDE6;padding:3px 10px;border-radius:999px;white-space:nowrap;font-weight:400;}
  .board-badge{position:fixed;top:74px;left:24px;z-index:40;font-size:11px;color:var(--ink-2);background:rgba(255,255,255,.94);border:1px solid var(--line);padding:6px 12px;border-radius:999px;box-shadow:var(--shadow-sm);pointer-events:none;}

  /* ===== 交互增强 ===== */
  .box.done{background:var(--brand);color:#fff;}
  .phone{transition:box-shadow .25s,outline-color .25s;}
  .phone.focus-current{outline:3px solid var(--brand);outline-offset:4px;box-shadow:0 0 0 9px rgba(232,98,45,.13),var(--shadow-md);}
  .global-toast{position:fixed;left:50%;top:86px;transform:translate(-50%,-12px);background:rgba(43,42,40,.94);color:#fff;border-radius:12px;padding:12px 20px;font-size:13px;z-index:9999;opacity:0;pointer-events:none;transition:.24s;max-width:78vw;text-align:center;box-shadow:var(--shadow-md);}
  .global-toast.show{opacity:1;transform:translate(-50%,0);}
  .app-dialog-mask{position:fixed;inset:0;background:rgba(30,28,25,.46);z-index:9000;display:none;align-items:center;justify-content:center;padding:20px;}
  .app-dialog-mask.show{display:flex;}
  .app-dialog{background:#fff;border-radius:18px;padding:22px;width:400px;max-width:100%;box-shadow:0 18px 50px rgba(43,42,40,.2);max-height:82vh;overflow-y:auto;}
  .app-dialog h3{font-size:16px;font-weight:600;margin-bottom:8px;}
  .app-dialog p{font-size:13px;color:var(--ink-2);line-height:1.7;margin-bottom:14px;}
  .app-dialog .d-opts{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;}
  .d-chip{border:1px solid var(--line);background:#fff;border-radius:999px;padding:8px 14px;font-size:13px;color:var(--ink-2);cursor:pointer;font-family:inherit;transition:.15s;}
  .d-chip:hover{border-color:var(--brand);color:var(--brand);}
  .d-chip.on{background:var(--brand-soft);border-color:var(--brand);color:var(--brand-deep);font-weight:500;}
  .app-dialog .d-actions{display:flex;gap:8px;}
  .app-dialog .d-actions .btn{flex:1;}
  .stars span{cursor:pointer;transition:.15s;}
  .stars span.off{filter:grayscale(1);opacity:.4;}
  .chip,.tb,.s,.back,.upload{transition:background .15s,border-color .15s,color .15s;}
  .back{cursor:pointer;}
  .back:hover{color:var(--brand);}
  .tb{cursor:pointer;}
</style>

<!--WP-ROUTE-CSS-->
<style id="wp-route-css">
  .wp-dock,.wp-crumb{display:none;}
  .wp-dock{position:fixed;top:60px;bottom:0;left:0;width:212px;z-index:60;background:#FBFAF7;
    border-right:1px solid var(--line);flex-direction:column;overflow-y:auto;padding:14px 10px 18px;
    box-sizing:border-box;font-family:inherit;}
  .wp-dock::-webkit-scrollbar{width:6px;} .wp-dock::-webkit-scrollbar-thumb{background:#DDD5C8;border-radius:3px;}
  body.wp-admin-on .wp-dock{display:flex;}
  .wp-dock .wp-title{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--ink);padding:4px 8px 10px;}
  .wp-dock .wp-title .p{width:24px;height:24px;border-radius:8px;background:var(--brand);color:#fff;display:grid;place-items:center;font-size:13px;}
  .wp-dock .wp-title small{display:block;font-size:10px;font-weight:400;color:var(--ink-3);margin-top:2px;}
  .wp-dock .wp-group{font-size:10px;letter-spacing:1.2px;color:var(--ink-3);padding:14px 8px 6px;border-top:1px dashed var(--line);margin-top:6px;}
  .wp-link{display:flex;align-items:center;gap:8px;width:100%;border:0;background:transparent;padding:8px 10px;
    border-radius:9px;font-family:inherit;font-size:12px;color:var(--ink-2);cursor:pointer;text-align:left;box-sizing:border-box;}
  .wp-link:hover{background:#F1EDE6;color:var(--ink);}
  .wp-link.on{background:var(--brand-soft);color:var(--brand-deep);font-weight:600;}
  .wp-link .ic{width:16px;text-align:center;flex:none;font-size:12px;}
  .wp-link .path{margin-left:auto;font-size:10px;opacity:.5;font-family:ui-monospace,Consolas,monospace;}
  .wp-dock .wp-foot{margin-top:auto;padding-top:12px;}
  .wp-dock .wp-note{font-size:10px;color:var(--ink-3);line-height:1.7;padding:9px;background:#F6F3ED;border-radius:8px;margin-top:10px;}
  .wp-crumb{position:fixed;top:60px;left:212px;right:0;height:44px;z-index:59;background:rgba(255,255,255,.96);
    border-bottom:1px solid var(--line);align-items:center;gap:9px;padding:0 16px;box-sizing:border-box;
    font-size:12px;color:var(--ink-2);}
  body.wp-admin-on .wp-crumb{display:flex;}
  .wp-crumb .wp-navbtn{border:1px solid var(--line);background:#fff;border-radius:7px;width:26px;height:26px;
    cursor:pointer;font-family:inherit;font-size:12px;color:var(--ink-2);flex:none;}
  .wp-crumb .wp-navbtn:hover{border-color:var(--brand);color:var(--brand);}
  .wp-crumb b{color:var(--ink);font-weight:600;}
  .wp-crumb code{font-size:11px;background:#F1EDE6;padding:4px 9px;border-radius:6px;color:var(--brand-deep);white-space:nowrap;}
  .wp-crumb .wp-spacer{flex:1;}
  .wp-crumb .wp-route-input{width:236px;border:1px solid var(--line);border-radius:8px;padding:6px 10px;
    font-family:inherit;font-size:11px;color:var(--ink);outline:none;background:#fff;}
  .wp-crumb .wp-route-input:focus{border-color:var(--brand);}
  .wp-crumb .wp-go{border:1px solid var(--brand);background:var(--brand);color:#fff;border-radius:8px;padding:6px 11px;
    font-family:inherit;font-size:11px;cursor:pointer;}
  .wp-crumb .wp-live{font-size:10px;color:var(--green);white-space:nowrap;}
  body.wp-admin-on .canvas-viewport{top:104px;left:212px;}
