    phone.appendChild(mask);
  }
  mask.querySelector('.m-title').textContent=title;
  mask.querySelector('.m-desc').textContent=desc;
  const ok=mask.querySelector('.act-ok'), cg=mask.querySelector('.act-cancel');
  ok.textContent=okText||'确定';
  cg.textContent=cancelText||'取消';
  cg.style.display=cancelText?'':'none';
  ok.onclick=()=>{ mask.classList.remove('show'); if(typeof onConfirm==='function') onConfirm(); };
  cg.onclick=()=>{ mask.classList.remove('show'); };
  mask.classList.add('show');
}

