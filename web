  const SINGLE_FILES = {'home':'暖爪-原型图-01-官网.html','owner':'暖爪-原型图-02-宠主端.html','sitter':'暖爪-原型图-03-喂养师端.html','admin':'暖爪-原型图-04-运营后台.html'};
  let scale = 1, tx = 0, ty = 0;
  const MIN = 0.2, MAX = 2.5;
  const viewport = () => document.getElementById('viewport');
  const canvasEl = () => document.getElementById('canvas');
  function applyTransform(){
    canvasEl().style.transform = `translate(${tx}px,${ty}px) scale(${scale})`;
    document.getElementById('zoom-label').textContent = Math.round(scale*100)+'%';
  }
  function zoom(delta){
    const vp = viewport(), cx = vp.clientWidth/2, cy = vp.clientHeight/2;
    const ns = Math.min(MAX, Math.max(MIN, scale+delta));
    tx = cx - (cx-tx)*(ns/scale); ty = cy - (cy-ty)*(ns/scale);
    scale = ns; applyTransform();
  }
  function fitBoard(all){
    const vp = viewport(), cv = canvasEl();
    if(!cv.scrollWidth) return;
    const pad = 40;
    const raw = Math.min((vp.clientWidth-pad)/cv.scrollWidth, (vp.clientHeight-pad)/cv.scrollHeight, 1);
    scale = Math.min(1, Math.max(all ? MIN : 0.5, raw));
    tx = (vp.clientWidth-cv.scrollWidth*scale)/2; ty = 16;
    applyTransform();
  }
  function fitView(){ fitBoard(true); }
  function focusTo(el){
    if(typeof el === 'string') el = document.getElementById(el);
    if(!el) return;
    const vp = viewport(), r = el.getBoundingClientRect(), v = vp.getBoundingClientRect();
    tx += (v.left+v.width/2)-(r.left+r.width/2);
    ty += (v.top+v.height/2)-(r.top+r.height/2);
    applyTransform();
  }
  function jumpTo(id){ location.href = SINGLE_FILES[String(id).replace('page-','')] || '暖爪-原型图.html'; }
  function go(p){ location.href = SINGLE_FILES[p] || '暖爪-原型图.html'; }

  (function(){
    let dragging=false, sx=0, sy=0, ox=0, oy=0;
    const vp = document.getElementById('viewport');
    vp.addEventListener('mousedown', e => {
      if(e.target.closest('.phone') && e.target.closest('button,.chip,.tb,.switch,.seg,.input,.upload,.check,.back,[onclick]')) return;
      dragging=true; vp.classList.add('grabbing');
      sx=e.clientX; sy=e.clientY; ox=tx; oy=ty;
    });
    window.addEventListener('mousemove', e => { if(!dragging)return; tx=ox+(e.clientX-sx); ty=oy+(e.clientY-sy); applyTransform(); });
    window.addEventListener('mouseup', () => { dragging=false; vp.classList.remove('grabbing'); });
    vp.addEventListener('wheel', e => { e.preventDefault(); zoom(e.deltaY<0?0.12:-0.12); }, {passive:false});
  })();

