  var SEC2K = {"sec-dash": "dash", "sec-order": "order", "sec-dispatch": "dispatch", "sec-audit": "audit", "sec-service": "service", "sec-emergency": "emergency", "sec-finance": "finance", "sec-member": "member", "sec-sitter": "sitter", "sec-user": "user", "sec-coupon": "coupon", "sec-price": "price", "sec-review": "review", "sec-msg": "msg", "sec-system": "system", "sec-dict": "dict"};
  var MAP = {}; ROUTES.forEach(function(r){ MAP[r.k]=r; });
  var IS_MAIN = !!document.getElementById('board-admin');
  var curRoute = 'dash', fromHash = false;
  var stack = [], sIdx = -1;
  function pushStack(k){
    if(sIdx < stack.length-1) stack = stack.slice(0, sIdx+1);
    if(stack[stack.length-1] !== k){ stack.push(k); }
    sIdx = stack.length-1;
  }
  function moveStack(d){
    var n = sIdx + d;
    if(n < 0){ try{ toast(null,'已经是最早的路由'); }catch(e){} return false; }
    if(n > stack.length-1){ try{ toast(null,'已经是最新的路由'); }catch(e){} return false; }
    sIdx = n;
    var k = stack[n];
    try{ history.replaceState({wp:k},'', '#/admin/'+k); }catch(e){}
    applyAdminRoute(k,{silent:true,noFocus:false});
    return true;
  }
  function routeBack(){ return moveStack(-1); }
  function routeForward(){ return moveStack(1); }
  window.routeBack = routeBack;
  window.routeForward = routeForward;
  window.routeStack = function(){ return {list:stack.slice(), idx:sIdx}; };
  function el(id){ return document.getElementById(id); }
  function setText(id,v){ var e=el(id); if(e) e.textContent=v; }

  function parseHash(){
    var h=(location.hash||'').replace(/^#/,'');
    var p=(h.split('?')[0]||'').split('/').filter(Boolean);
    if(p[0]==='admin') return {board:'admin', route:p[1]||'dash'};
    if(p[0]==='home'||p[0]==='owner'||p[0]==='sitter') return {board:p[0], route:'dash'};
    return {board:IS_MAIN?'home':'admin', route:'dash'};
  }
  function zone(){ return el('page-admin'); }
  /* 单模块路由：固定 100% 可读比例；全览路由才缩到看全貌 */
  function resetView(){
    try{
      if(IS_MAIN){
        var k=(typeof cur!=='undefined')?cur:'admin';
        var st=state[k];
        if(st){ st.scale=1; st.tx=20; st.ty=16; applyTransform(k); }
      }else{
        scale=1; tx=20; ty=16; applyTransform();
      }
    }catch(e){}
  }

  function applyAdminRoute(key, opts){
    opts=opts||{};
    var k=(MAP[key]||key==='all')?key:'dash';
    curRoute=k;
    var isAll=(k==='all'), r=MAP[k], z=zone();
    if(z){
      z.querySelectorAll('.section[id^="sec-"]').forEach(function(s){
        var show=isAll||(r&&s.id===r.sec);
        s.style.display=show?'':'none';
        if(show&&!isAll) s.classList.add('route-active'); else s.classList.remove('route-active');
      });
      z.querySelectorAll('.grid').forEach(function(g){
        var ss=g.querySelectorAll('.section[id^="sec-"]');
        if(!ss.length) return;
        var any=false; ss.forEach(function(s){ if(s.style.display!=='none') any=true; });
        g.style.display=any?'':'none';
      });
    }
    var eh=el('admin-extra-head');
    if(eh) eh.style.display=(isAll||(r&&r.group==='用户与供给'))?'':'none';
    var nav=el('admin-nav-card');
    if(nav) nav.style.display=isAll?'':'none';
    document.querySelectorAll('.wp-link[data-k]').forEach(function(b){ b.classList.toggle('on', b.dataset.k===k); });
    document.querySelectorAll('#admin-nav .chip,#admin-nav2 .chip').forEach(function(c){
      var m=(c.getAttribute('onclick')||'').match(/routeTo\('([\w-]+)'\)/);
      c.classList.toggle('on', !!m && m[1]===k);
    });
    setText('wp-crumb-name', isAll?'全部模块（画布全览）':(r?r.name:'数据看板'));
    setText('wp-crumb-group', isAll?'画布全览':(r?r.group:'核心运营'));
    setText('wp-hash', '#/admin/'+k);
    setText('wp-live', isAll?'● 全览模式':'● 路由已同步');
    window.__wpRoute = k;
    if(!opts.noFocus){
      setTimeout(function(){
        if(isAll){ try{ fitView(); }catch(e){} }
        else { resetView(); }
      },160);
    }
    if(!opts.silent && opts.fromMenu && typeof toast==='function'){
      try{ toast(null,'已进入 '+(isAll?'全部模块':r.name)+' · #/admin/'+k); }catch(e){}
    }
    return k;
  }

  window.applyAdminRoute = applyAdminRoute;
  window.getRoute = function(){ return window.__wpRoute||'dash'; };

  function routeTo(k, opts){
    opts=opts||{};
    var key=(MAP[k]||k==='all')?k:'dash';
    if(!opts.silent) opts.fromMenu=true;
    var hash='#/admin/'+key;
    if(location.hash!==hash){
      try{ history.pushState({wp:key},'',hash); }
      catch(e){ location.hash=hash; }
    }
    pushStack(key);
    applyAdminRoute(key,opts);
    if(IS_MAIN && !opts.silent){
      try{ showBoard('admin'); }catch(e){}
    }
    return key;
  }
  window.routeTo = routeTo;

  function goRoute(v){
    v=(v||'').trim().replace(/^#/,'').replace(/^\//,'');
    if(!v) return false;
    var p=v.split('/').filter(Boolean), key;
    if(p[0]==='admin') key=p[1]||'dash';
    else if(p.length===1) key=p[0];
    else key='';
    if(!MAP[key] && key!=='all'){
      try{ toast(null,'路由不存在：'+v+'（可用 /admin/dash … /admin/dict、/admin/all）'); }catch(e){}
      return false;
    }
    window.routeTo(key); return true;
  }
  window.goRoute = goRoute;

  function routeBoard(k){
    var h=(k==='admin')?('#/admin/'+(curRoute==='all'?'all':curRoute)):('#/'+k);
    if(location.hash!==h) location.hash=h;
    applyHash();   /* 同步生效，不依赖 hashchange 的异步时机 */
  }
  window.routeBoard = routeBoard;

  function applyHash(){
    var p=parseHash();
    fromHash=true;
    try{
      if(IS_MAIN) showBoard(p.board);
      if(p.board==='admin'){
        document.body.classList.add('wp-admin-on');
        pushStack(p.route);
        applyAdminRoute(p.route,{silent:true});
      }else if(IS_MAIN){
        document.body.classList.remove('wp-admin-on');
      }else{
        document.body.classList.add('wp-admin-on');
      }
    }finally{ fromHash=false; }
  }
  window.applyHash = applyHash;

  /* 主文件：showBoard 同步 URL / 侧栏可见性；tab 由 routeBoard 写 hash */
  if(IS_MAIN){
    var _showBoard = showBoard;
    window.showBoard = function(k){
      _showBoard(k);
      document.body.classList.toggle('wp-admin-on', k==='admin');
      var si=el('open-single');
      if(si) try{ si.href=SINGLE_FILES[k]+(k==='admin'?('#/admin/'+curRoute):('#/'+k)); }catch(e){}
      if(!fromHash){
        var h=(k==='admin')?('#/admin/'+curRoute):('#/'+k);
        if(location.hash!==h) try{ history.replaceState(null,'',h); }catch(e){}
      }
    };
  }

  /* 跨模块按钮：目标 section 被隐藏时自动切到对应路由，保证点完还能继续操作 */
  var _focusTo = window.focusTo;
  window.focusTo = function(x){
    var t=(typeof x==='string')?document.getElementById(x):x;
    if(t && t.closest){
      var sec=t.closest('#page-admin .section[id^="sec-"]');
      if(sec && sec.style.display==='none' && SEC2K[sec.id]){
        var k=SEC2K[sec.id];
        try{ history.replaceState(null,'','#/admin/'+k); }catch(e){}
        applyAdminRoute(k,{silent:true,noFocus:true});
      }
    }
    return _focusTo(x);
  };

  /* 旧导航/回顶部动作接入路由 */
  var _act = window.act;
  window.act = function(elx,key,extra){
    if(key==='adminNav'){
      var k=SEC2K[extra]||MAP[extra]&&extra||'dash';
      if(elx && elx.classList && elx.classList.contains('chip')){
        try{ adminNavTo(MAP[k]?MAP[k].sec:'sec-dash', elx); }catch(e){}
      }
      return window.routeTo(k);
    }
    if(key==='adminBackNav'){
      try{ adminNavTo('admin-nav-card', null); }catch(e){}
      return window.routeTo('all');
    }
    return _act(elx,key,extra);
  };

  window.addEventListener('hashchange', applyHash);
  window.addEventListener('popstate', applyHash);
  window.addEventListener('load', function(){
    if(!location.hash){
      try{ history.replaceState(null,'',IS_MAIN?'#/home':'#/admin/dash'); }catch(e){}
    }
    applyHash();
  });
  if(document.readyState==='complete') setTimeout(applyHash,0);
})();
/* ===== /WP-ROUTE-JS ===== */

/* ===== WP-PRICE-JS · 会员套餐自定义价格 ===== */
(function(){
  var KEY='warmpaw.memberPlans';
  var DEFAULT=[
    {k:'month',name:'月度会员',months:1,price:29,desc:'适合短期出行需求',on:true,builtin:true},
    {k:'year', name:'年度会员',months:12,price:199,desc:'立省 ¥149 · 赠送 2 张 ¥20 券',on:true,builtin:true}
  ];
  function clone(ps){ return ps.map(function(p){ return {k:p.k,name:p.name,months:p.months,price:p.price,desc:p.desc,on:p.on,builtin:p.builtin}; }); }
  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function fmt(n){ n=Math.round(Number(n)*100)/100; return String(n).replace(/\.00$/,''); }
  function period(m){ return m===1?'月':(m===12?'年':m+'个月'); }
  function money(p){ return '¥'+fmt(p.price)+'/'+period(p.months); }
  function plans(){ return clone(window.MEMBER_PLANS||DEFAULT); }
  function log(text){ try{ if(typeof adminLog==='function') adminLog(text); }catch(e){} }
  function toast(el,msg){ try{ if(typeof window.toast==='function') window.toast(el||document.body,msg); }catch(e){} }

  window.MEMBER_PLANS = clone(DEFAULT);
  window.fmtPrice = fmt;
  window.wpPlans = plans;

  /* 弹窗扩展：opt.input 时插入一个真正的输入框，输入值走 window.__wpDlgInput */
  var _dialog = window.dialog;
  window.dialog = function(opt){
    var old=document.getElementById('wp-dlg-input-wrap'); if(old) old.parentNode.removeChild(old);
    window.__wpDlgInput='';
    window.__wpDlgBadInput=false;
    _dialog(opt);
    if(opt && opt.input){
      var dlg=document.querySelector('#app-dialog-mask .app-dialog');
      var opts=document.getElementById('dlg-opts');
      if(dlg && opts){
        var wrap=document.createElement('div'); wrap.id='wp-dlg-input-wrap'; wrap.className='wp-dlg-input-wrap';
        var lb=document.createElement('label'); lb.textContent=opt.input.label||'自定义值';
        var inp=document.createElement('input');
        inp.id='wp-dlg-input'; inp.className='input'; inp.type='number'; inp.step='0.01';
        inp.min=opt.input.min||0.01; inp.max=opt.input.max||9999;
        inp.value=(opt.input.value!==undefined?opt.input.value:'');
        inp.placeholder='输入任意价格，留空则使用下方档位';
        wrap.appendChild(lb); wrap.appendChild(inp);
        dlg.insertBefore(wrap, opts);
        inp.addEventListener('input', function(){
          window.__wpDlgInput=String(inp.value).trim();
          window.__wpDlgBadInput=!!(inp.validity && inp.validity.badInput);
        });
        inp.addEventListener('keydown', function(e){
          if(e.key==='Enter'){ e.preventDefault(); var ok=document.getElementById('dlg-ok'); if(ok) ok.click(); }
        });
        setTimeout(function(){ try{ inp.focus(); }catch(e){} },40);
      }
    }
  };

  /* 后台：自定义套餐行 */
  function rowHtml(p){
    return '<div class="wp-plan-row" data-plan-key="'+esc(p.k||'')+'" data-paused="'+(p.on?'':'1')+'">'
      + '<input class="input wp-plan-name" value="'+esc(p.name)+'" placeholder="套餐名称">'
      + '<input class="input wp-plan-months" type="number" min="1" max="36" value="'+p.months+'" title="周期（月）">'
      + '<input class="input wp-plan-price" type="number" min="0.01" max="9999" step="0.01" value="'+fmt(p.price)+'">'
      + '<span class="wp-plan-preview"></span>'
      + '<span class="pill '+(p.on?'ok':'danger')+'">'+(p.on?'在售':'已停用')+'</span>'
      + '<button class="btn sm outline" onclick="act(this,\'adminPlanToggle\')">'+(p.on?'停用':'启用')+'</button>'
      + '<button class="btn sm outline" onclick="act(this,\'adminPlanRemove\')">删除</button>'
      + '</div>';
  }
  function rowPreview(row){
    var pr=row.querySelector('.wp-plan-price'), mo=row.querySelector('.wp-plan-months'), out=row.querySelector('.wp-plan-preview');
    if(!out) return;
    var n=Number(pr?pr.value:0), m=parseInt(mo?mo.value:0,10);
    out.textContent=(n>0&&m>0)?('¥'+fmt(n)+' / '+m+' 个月'):'请填写价格与周期';
  }
  function renderAdminRows(){
    var box=document.getElementById('wp-plan-custom'); if(!box) return;
    var customs=(window.MEMBER_PLANS||[]).filter(function(p){ return !p.builtin; });
    box.innerHTML = customs.length ? customs.map(rowHtml).join('')
      : '<div class="wp-plan-empty">暂无自定义套餐，点「+ 新增套餐」添加（如季度会员 / 3 个月 / ¥79）</div>';
    [].slice.call(box.querySelectorAll('.wp-plan-row')).forEach(rowPreview);
  }

  /* 宠主端：按当前价格重建方案卡片 */
  function renderMemberCards(){
    var box=document.getElementById('ow-member-plans'); if(!box) return;
    var picked=box.querySelector('[data-picked="1"]');
    var pk=picked?picked.getAttribute('data-plan'):'month';
    var list=(window.MEMBER_PLANS||[]).filter(function(p){ return p.on; });
    if(!list.some(function(p){return p.k===pk;})) pk=list.length?list[0].k:'';
    box.innerHTML=list.map(function(p){
      var on=p.k===pk;
      return '<div class="card" data-plan="'+esc(p.k)+'" data-plan-name="'+esc(p.name)+'" data-picked="'+(on?'1':'')+'"'
        + ' style="margin-bottom:8px;border:'+(on?'2px solid var(--brand)':'1px solid var(--line)')+';cursor:pointer;"'
        + ' onclick="act(this,\'memberPlan\')">'
        + '<div class="between"><span style="font-weight:600;">'+esc(p.name)+'</span>'
        + '<span class="price" style="font-size:18px;">'+esc(money(p))+'</span></div>'
        + '<div class="small muted">'+esc(p.desc)+'</div></div>';
    }).join('') || '<div class="small muted">暂无在售套餐，请在运营后台启用</div>';
    var btn=document.querySelector('#ow-member .body > .btn');
    if(btn && !btn.dataset.done){
      var c=box.querySelector('[data-picked="1"] .price');
      btn.textContent=c?('立即开通 · '+c.textContent):'立即开通';
    }
  }

  /* 统一应用：后台展示 + 宠主端 + 摘要 + 日志 + 持久化 + 跨端链接 */
  function applyMemberPlans(ps,opt){
    opt=opt||{};
    var list=clone(ps&&ps.length?ps:DEFAULT);
    window.MEMBER_PLANS=list;
    var m=list.filter(function(p){return p.k==='month';})[0];
    var y=list.filter(function(p){return p.k==='year';})[0];
    var qm=document.getElementById('wp-price-month'), qy=document.getElementById('wp-price-year');
    if(qm&&m) qm.textContent='¥'+fmt(m.price);
    if(qy&&y) qy.textContent='¥'+fmt(y.price);
    var sum=document.getElementById('wp-plan-summary');
    if(sum){
      var on=list.filter(function(p){return p.on;});
      sum.textContent='当前在售：'+on.map(function(p){return p.name+' '+money(p);}).join(' · ')+(on.length?'':'（无）');
    }
    renderAdminRows();
    renderMemberCards();
    var link=window.wpPlanLink();
    var li=document.getElementById('wp-plan-link'); if(li) li.value=link;
    [].slice.call(document.querySelectorAll('a.tab')).forEach(function(a){
      var h=a.getAttribute('href')||'';
      if(h.indexOf('02-宠主端')>=0 && m && y){
        a.setAttribute('href', h.split('#')[0].split('?')[0]+'#/owner?m='+fmt(m.price)+'&y='+fmt(y.price));
      }
    });
    try{ localStorage.setItem(KEY, JSON.stringify(list)); }catch(e){}
    if(opt.log) log(opt.log);
    return list;
  }
  window.applyMemberPlans = applyMemberPlans;

  function wpPlanLink(){
    var ps=window.MEMBER_PLANS||DEFAULT;
    var m=ps.filter(function(p){return p.k==='month';})[0]||{price:29};
    var y=ps.filter(function(p){return p.k==='year';})[0]||{price:199};
    var file=(location.pathname||'').split('/').pop()||'暖爪-原型图.html';
    return decodeURIComponent(file)+'#/admin/member?m='+fmt(m.price)+'&y='+fmt(y.price);
  }
  window.wpPlanLink = wpPlanLink;

  /* 新增动作 */
  function addRow(el){
    var box=document.getElementById('wp-plan-custom'); if(!box) return toast(el,'未找到自定义套餐区'),false;
    if(box.querySelector('.wp-plan-empty')) box.innerHTML='';
    var n=box.querySelectorAll('.wp-plan-row').length+1;
    var d=document.createElement('div');
    d.innerHTML=rowHtml({k:'',name:'自定义套餐 '+n,months:3,price:59,desc:'',on:true,builtin:false});
    var row=d.firstChild; box.appendChild(row); rowPreview(row);
    var inp=row.querySelector('.wp-plan-name'); if(inp){ inp.focus(); inp.select(); }
    toast(el,'已添加一行，填好名称 / 周期 / 价格后点「保存自定义配置」');
    return true;
  }
  function saveRows(el){
    var box=document.getElementById('wp-plan-custom');
    var rows=box?[].slice.call(box.querySelectorAll('.wp-plan-row')):[];
    var customs=[];
    for(var i=0;i<rows.length;i++){
      var r=rows[i];
      var name=(r.querySelector('.wp-plan-name')||{}).value||'';
      var mo=parseInt((r.querySelector('.wp-plan-months')||{}).value,10);
      var pr=Number((r.querySelector('.wp-plan-price')||{}).value);
      name=name.trim();
      if(!name){ toast(el,'第 '+(i+1)+' 行：套餐名称不能为空'); return false; }
      if(!(mo>=1&&mo<=36)){ toast(el,'第 '+(i+1)+' 行：周期需为 1 – 36 个月'); return false; }
      if(!(pr>0&&pr<=9999)){ toast(el,'第 '+(i+1)+' 行：价格需为 0.01 – 9999'); return false; }
      customs.push({k:r.dataset.planKey||('p_'+Date.now()+'_'+i), name:name, months:mo,
        price:Math.round(pr*100)/100, desc:'自定义套餐 · '+mo+' 个月有效期',
        on:r.dataset.paused!=='1', builtin:false});
    }
    var base=plans().filter(function(p){return p.builtin;});
    applyMemberPlans(base.concat(customs),{log:'保存会员套餐自定义配置（'+customs.length+' 个自定义档位）',el:el});
    toast(el,'已保存 '+customs.length+' 个自定义套餐，宠主端会员中心已同步');
    return true;
  }
  function toggleRow(el){
    var r=el.closest('.wp-plan-row'); if(!r) return false;
    var paused=r.dataset.paused==='1';
    r.dataset.paused=paused?'':'1';
    var pill=r.querySelector('.pill');
    if(pill){ pill.textContent=paused?'在售':'已停用'; pill.className='pill '+(paused?'ok':'danger'); }
    el.textContent=paused?'停用':'启用';
    var k=r.dataset.planKey;
    if(k){
      var ps=plans(); ps.forEach(function(p){ if(p.k===k) p.on=paused; });
      applyMemberPlans(ps,{log:(paused?'启用':'停用')+'自定义会员套餐',el:el});
    }
    toast(el,paused?'套餐已启用':'套餐已停用，宠主端将不再展示');
    return true;
  }
  function removeRow(el){
    var r=el.closest('.wp-plan-row'); if(!r) return false;
    var k=r.dataset.planKey; r.parentNode.removeChild(r);
    var box=document.getElementById('wp-plan-custom');
    if(box && !box.querySelector('.wp-plan-row')) box.innerHTML='<div class="wp-plan-empty">暂无自定义套餐，点「+ 新增套餐」添加</div>';
    if(k){
