  function collect(){
    var bad=[],name=v('wp-cp-name'),amount=n('wp-cp-amount'),threshold=n('wp-cp-threshold');
    if(!name) bad.push('券模板名称不能为空');
    if(!isFinite(amount)||amount<1||amount>1000) bad.push('面额需为 1 – 1000 元');
    if(!isFinite(threshold)||threshold<0||threshold>10000) bad.push('使用门槛需为 0 – 10000 元');
    var d={name:name,amount:amount,threshold:threshold,scope:v('wp-cp-scope')||'全品类',
      valid:v('wp-cp-valid'),status:v('wp-cp-status')==='pause'?'pause':'on',type:curType};
    if(curType==='push'){
      d.audience=v('wp-cp-push-audience')||'all'; d.entry='后台直发'; d.pushTarget=v('wp-cp-push-target');
      d.pushPer=n('wp-cp-push-per'); d.per=d.pushPer; d.stock=0; d.from=''; d.to=''; d.risk=1;
      if(!isFinite(d.pushPer)||d.pushPer<1||d.pushPer>10) bad.push('每人发放张数需为 1 – 10');
    }else{
      d.audience=v('wp-cp-claim-audience')||'all'; d.entry=v('wp-cp-entry')||'领券中心';
      d.per=n('wp-cp-per'); d.stock=n('wp-cp-stock'); d.from=v('wp-cp-from'); d.to=v('wp-cp-to');
      d.risk=q('#wp-cp-risk')&&q('#wp-cp-risk').checked?1:0; d.code=v('wp-cp-code'); d.pushTarget=''; d.pushPer=1;
      if(!isFinite(d.per)||d.per<1||d.per>10) bad.push('每人限领需为 1 – 10 张');
      if(!isFinite(d.stock)||d.stock<1||d.stock>999999) bad.push('总库存需大于 0');
      var t=find(curId); if(t&&d.stock<t.claimed) bad.push('总库存不能小于已领取 '+fmt(t.claimed)+' 张');
      if(d.from&&d.to&&d.from>d.to) bad.push('领取开始时间需早于结束时间');
    }
    if(bad.length){ toast(null,'未保存：'+bad[0]+(bad.length>1?'（共 '+bad.length+' 处）':'')); return null; }
    return d;
  }
